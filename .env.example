# ============================================================
# 北斗网格化系统环境配置示例 (请复制为 .env.local 后填入个人配置)
# .env.local 已被 .gitignore 忽略，不会提交到开源仓库
# ============================================================

# [可选] 天地图开发者 Token（用于加载在线天地图卫星影像与注记）
# 未配置时系统将自动切换为公开底图与内置网格底图，开箱即用
VITE_TIANDITU_TOKEN=

# [可选] Cesium Ion Access Token
VITE_CESIUM_ION_TOKEN=

# [可选] 本地离线 3D Tiles 建筑白模根目录（未配置时使用内置示范低空 CBD 建筑）
# 目录结构示例：<LOCAL_3DTILES_DIR>/shenzhen/tileset.json
LOCAL_3DTILES_DIR=
LOCAL_3DTILES_GZIP_DIR=

# [可选] 本地离线影像瓦片目录（示例：<LOCAL_TILES_DIR>/world/{z}/{x}/{y}.jpg）
LOCAL_TILES_DIR=

# [可选] 本地离线 Quantized-Mesh 地形目录（示例：<LOCAL_TERRAIN_DIR>/layer.json）
LOCAL_TERRAIN_DIR=
